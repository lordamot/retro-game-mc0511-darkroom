; Full-screen opening and ending pages are stored in native DAT records.
; The splash precedes START, so no gameplay or event-log time has begun.
SPLASH:
 MOV #EV_NATIVE_SPLASH,R0
 CALL DISK_READ
 CALL SV_CLEAR
 CALL DRAW_PAGE
 CALL FLUSH
 MOV KEY_SERIAL,LAST_KEY
1$: CMP KEY_SERIAL,LAST_KEY
 BEQ 1$
 MOV KEY_SERIAL,LAST_KEY
 CMP KEY_CODE,#004
 BNE 2$
 JMP RT_EXIT
2$: CMP KEY_CODE,#153
 BNE 1$
 JMP START
END_OPEN:
 MOV #12.,TAB
 MOV #EV_NATIVE_END,R0
 TST STORES+R_FLEET_BEACON
 BEQ 1$
 INC R0
1$: CALL DISK_READ
 MOV KEY_SERIAL,LAST_KEY
 CLR REPEAT_CD
 JMP SV_CLEAR
END_INPUT:
 CMP R0,#031
 BNE 1$
 JMP RT_EXIT
1$: CMP R0,#030
 BNE 9$
 ; Discard MAIN/KEY_INPUT's return stack when beginning a fresh game.
 MOV #STACK_TOP,SP
 JMP START
9$: RETURN
DRAW_PAGE:
 CALL SCREEN_CLEAR
 CALL LOG_WHITE
 CLR MENU_COUNT
 MOV @#SCENE_BASE+2,R1
 CALL PUTS
 JMP DRAW_VERSION
