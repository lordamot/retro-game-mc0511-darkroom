; Village simulation. Original cooldowns and recipe costs, in real seconds.
STOKE:
 TST STOKE_CD
 BEQ 1$
 JMP WAIT_MSG
1$: MOV #1,R1
 TST FIRE
 BNE 2$
 MOV #5,R1
2$: TST FOREST
 BEQ 3$
 CMP STORES+R_WOOD,R1
 BGE 21$
 JMP CANT_MSG
21$: SUB R1,STORES+R_WOOD
3$: TST FIRE
 BNE 4$
 MOV #3,FIRE
 BR 5$
4$: CMP FIRE,#4
 BGE 5$
 INC FIRE
5$: CLR FIRE_AGE
 MOV #100.,STOKE_CD
 CALL FIRE_NOTIFY
 TST BUILDER
 BPL 6$
 MOV #S_FIRELIT,NOTICE
 CALL NOTIFY
 MOV CLOCK,R0
 XOR R0,SEED
 CALL MAP_INIT
 CLR BUILDER
 CLR BUILDER_TIME
6$: RETURN
GATHER:
 TST GATHER_CD
 BEQ 1$
 JMP WAIT_MSG
1$: MOV #10.,R1
 TST BUILDINGS+B_CART
 BEQ 2$
 MOV #50.,R1
2$: MOV #R_WOOD,R0
 MOV #STORES,R2
 CALL ADD_RESOURCE
 MOV #600.,GATHER_CD
 MOV #S_GATHERED,NOTICE
 CALL NOTIFY
 RETURN
CHECK_TRAPS:
 TST TRAPS_CD
 BEQ 1$
 JMP WAIT_MSG
1$: MOV BUILDINGS+B_TRAP,R4
 BEQ 8$
 TST STORES+R_BAIT
 BEQ 2$
 MOV R4,R0
 CMP R0,STORES+R_BAIT
 BLE 11$
 MOV STORES+R_BAIT,R0
11$: SUB R0,STORES+R_BAIT
 ADD R0,R4
2$: MOV #1000.,R1
 CALL RAND_N
 MOV #R_FUR,R2
 CMP R0,#500.
 BLO 3$
 MOV #R_MEAT,R2
 CMP R0,#750.
 BLO 3$
 MOV #R_SCALES,R2
 CMP R0,#850.
 BLO 3$
 MOV #R_TEETH,R2
 CMP R0,#930.
 BLO 3$
 MOV #R_CLOTH,R2
 CMP R0,#995.
 BLO 3$
 MOV #R_CHARM,R2
3$: MOV R2,R0
 MOV #1,R1
 MOV #STORES,R2
 CALL ADD_RESOURCE
 SOB R4,2$
 MOV #900.,TRAPS_CD
 MOV #S_TRAPPED,NOTICE
 CALL NOTIFY
8$: RETURN

; R4 -> (count, resource offset, amount...), R5 resource base. C=can't afford.
COST_TEST:
 MOV R4,R2
 MOV (R2)+,R3
 BEQ 3$
1$: MOV (R2)+,R0
 ADD R5,R0
 CMP (R0),(R2)+
 BLT 4$
 SOB R3,1$
3$: CLC
 RETURN
4$: SEC
 RETURN
COST_PAY:
 MOV R4,R2
 MOV (R2)+,R3
 BEQ 3$
1$: MOV (R2)+,R0
 ADD R5,R0
 SUB (R2)+,(R0)
 SOB R3,1$
3$: RETURN

; R4 recipe. Construct its dynamic cost in COST_BUFFER.
RECIPE_COST:
 MOV 10.(R4),R0
 MOV #COST_BUFFER,R1
 MOV (R0)+,R2
 MOV R2,(R1)+
1$: TST R2
 BEQ 3$
 MOV (R0)+,(R1)+
 MOV (R0)+,(R1)+
 DEC R2
 BR 1$
3$: TST 12.(R4)
 BEQ 4$
 MOV 4(R4),R0
 MOV BUILDINGS(R0),R1
 MUL 12.(R4),R1
 ADD R1,COST_BUFFER+4
4$: RETURN
COST_BUFFER: .BLKW 9.

CRAFT:
 CMP TEMPERATURE,#1
 BGT 99$
 MOV #S_REST,NOTICE
 CALL NOTIFY
 RETURN
99$:
 ; R0 recipe ordinal
 ASL R0
 ASL R0
 ASL R0
 ASL R0
 ADD #RECIPES,R0
 MOV R0,R4
 CALL RECIPE_COST
 MOV 4(R4),R0
 MOV #STORES,R5
 TST 2(R4)
 BNE 1$
 MOV #BUILDINGS,R5
1$: ADD R0,R5
 CMP (R5),#30000.
 BGE 11$
 TST 6(R4)
 BEQ 2$
 CMP (R5),6(R4)
 BLT 2$
11$: MOV #S_MAX,NOTICE
 CALL NOTIFY
 RETURN
2$: MOV R4,-(SP)
 MOV R5,-(SP)
 MOV #COST_BUFFER,R4
 MOV #STORES,R5
 CALL COST_TEST
 BCS 4$
 CALL COST_PAY
 MOV (SP)+,R5
 MOV (SP)+,R4
 ADD 8.(R4),(R5)
 CMP (R5),#30000.
 BLE 21$
 MOV #30000.,(R5)
21$: MOV #S_BUILT,NOTICE
 CALL NOTIFY
 CALL CAPACITIES
 RETURN
4$: MOV (SP)+,R5
 MOV (SP)+,R4
CANT_MSG:
 MOV #S_CANT,NOTICE
 CALL NOTIFY
 RETURN
WAIT_MSG:
 MOV #S_WAIT,NOTICE
 CALL NOTIFY
 RETURN

; R4 recipe, R0 ordinal -> C set if hidden. Seen recipes remain visible.
RECIPE_VISIBLE:
 MOV R0,R3
 ASL R3
 TST UNLOCKED(R3)
 BNE 8$
 CMP BUILDER,#4
 BLT 9$
 MOV 2(R4),R0
 BEQ 3$
 CMP R0,#1
 BNE 1$
 TST BUILDINGS+B_WORKSHOP
 BEQ 9$
 BR 3$
1$: CMP R0,#2
 BNE 2$
 TST BUILDINGS+B_TRADING_POST
 BEQ 9$
 MOV 4(R4),R0
 CMP R0,#R_COMPASS
 BEQ 7$
 TST SEEN(R0)
 BEQ 9$
 BR 7$
2$: TST FLAGS+F_EXECUTIONER
 BEQ 9$
 MOV 14.(R4),R0
 BMI 7$
 TST STORES(R0)
 BEQ 9$
 BR 7$
3$: MOV 10.(R4),R0
 MOV (R0)+,R1
4$: MOV (R0)+,R2
 TST SEEN(R2)
 BEQ 9$
 CMP R2,#R_WOOD
 BNE 5$
 MOV (R0),R2
 ASR R2
 CMP STORES+R_WOOD,R2
 BLT 9$
5$: TST (R0)+
 SOB R1,4$
7$: MOV #1,UNLOCKED(R3)
8$: CLC
 RETURN
9$: SEC
 RETURN

VILLAGE_SECOND:
 ; Discover resource types; flags are not lost when stock reaches zero.
 MOV #STORES,R0
 MOV #SEEN,R1
 MOV #NRES,R2
1$: TST (R0)+
 BEQ 2$
 MOV #1,(R1)
2$: TST (R1)+
 SOB R2,1$
 INC FIRE_AGE
 CMP FIRE_AGE,#300.
 BLO 3$
 CLR FIRE_AGE
 TST FIRE
 BEQ 3$
 CMP FIRE,#2
 BGT 32$
 CMP BUILDER,#4
 BLT 32$
 TST STORES+R_WOOD
 BEQ 32$
 DEC STORES+R_WOOD
 BR 3$ ; builder maintains the existing fire level
32$: DEC FIRE
 CALL FIRE_NOTIFY
3$: INC TEMP_TIME
 CMP TEMP_TIME,#30.
 BLO 5$
 CLR TEMP_TIME
 CMP TEMPERATURE,FIRE
 BEQ 4$
 BGT 31$
 INC TEMPERATURE
 BR 33$
31$: DEC TEMPERATURE
33$: MOV TEMPERATURE,R0
 ASL R0
 MOV TEMP_TEXT(R0),NOTICE
 CALL NOTIFY
4$: CMP BUILDER,#4
 BGE 5$
 TST BUILDER
 BMI 5$
 TST BUILDER
 BEQ 41$
 CMP TEMPERATURE,#3
 BLT 5$
41$:
 INC BUILDER
 MOV BUILDER,R0
 ASL R0
 MOV BUILDER_MSG-2(R0),NOTICE
 CALL NOTIFY
 CMP BUILDER,#1
 BNE 5$
 CLR BUILDER_TIME
5$: CMP BUILDER,#1
 BLT 6$
 TST FOREST
 BNE 6$
 INC BUILDER_TIME
 CMP BUILDER_TIME,#15.
 BLO 6$
 MOV #1,FOREST
 MOV #S_FOREST,NOTICE
 CALL NOTIFY
6$: INC INCOME_TIME
 CMP INCOME_TIME,#10.
 BLO 7$
 CLR INCOME_TIME
 CALL COLLECT_INCOME
7$: INC POP_TIME
 CMP POP_TIME,POP_DELAY
 BLO 9$
 CLR POP_TIME
 MOV #5,R1
 CALL RAND_N
 MOV #30.,POP_DELAY
 CMP R0,#2
 BLO 71$
 ADD #60.,POP_DELAY
 CMP R0,#4
 BLO 71$
 ADD #60.,POP_DELAY
71$: MOV BUILDINGS+B_HUT,R0
 ASL R0
 ASL R0
 CMP POPULATION,R0
 BGE 9$
 SUB POPULATION,R0
 MOV R0,R4
 MOV #32767.,R1
 CALL RAND_N
 ; Original floor(space/2 + random*space/2), with half steps.
 MOV R0,R2
 MOV R4,R0
 MUL R2,R0
 DIV #32767.,R0
 ADD R4,R0
 ASR R0
 BNE 72$
 INC R0
72$: ADD R0,POPULATION
 MOV #S_ARRIVED,NOTICE
 CALL NOTIFY
9$: TST GAMBLE_TIME
 BEQ 10$
 DEC GAMBLE_TIME
 BNE 10$
 MOV GAMBLE_RES,R0
 MOV GAMBLE_AMOUNT,R1
 MOV #STORES,R2
 CALL ADD_RESOURCE
 MOV #S_RETURNED,NOTICE
 CALL NOTIFY
10$: TST AWAY
 BNE 12$
 TST ACTIVE_SCENE
 BNE 12$
 INC EVENT_TIME
 CMP EVENT_TIME,EVENT_DELAY
 BLO 12$
 CLR EVENT_TIME
 MOV #181.,R1
 CALL RAND_N
 ADD #180.,R0
 MOV R0,EVENT_DELAY
 CALL VILLAGE_EVENT
12$: RETURN
BUILDER_MSG: .WORD S_STRANGER,S_SHIVER,S_SLEEP,S_BUILDER

FREE_WORKERS:
 MOV POPULATION,R0
 MOV #JOBS+2,R1
 MOV #NWORK-1,R2
1$: SUB (R1)+,R0
 SOB R2,1$
 RETURN
JOB_AVAILABLE:
 ; R4 worker record -> C if locked
 MOV 2(R4),R0
 BEQ 3$
 MOV 4(R4),R1
 CMP R0,#1
 BNE 1$
 TST BUILDINGS(R1)
 BEQ 4$
 BR 3$
1$: TST AWAY
 BEQ 11$
 TST HOME_FLAGS(R1)
 BEQ 4$
 BR 3$
11$: TST FLAGS(R1)
 BEQ 4$
3$: CLC
 RETURN
4$: SEC
 RETURN
ASSIGN_JOB:
 ; R0 job byte offset; R1 positive add, negative remove
 TST R0
 BEQ 9$
 TST R1
 BMI 2$
 MOV R0,-(SP)
 CALL FREE_WORKERS
 MOV R0,R3
 MOV (SP)+,R0
 TST R3
 BLE 9$
 INC JOBS(R0)
 RETURN
2$: TST JOBS(R0)
 BEQ 9$
 DEC JOBS(R0)
9$: RETURN

COLLECT_INCOME:
 CMP BUILDER,#4
 BLT 1$
 MOV #R_WOOD,R0
 MOV #2,R1
 MOV #STORES,R2
 CALL ADD_RESOURCE
1$: CALL FREE_WORKERS
 MOV R0,JOBS
 CLR INC_JOB
2$: MOV INC_JOB,R0
 ASL R0
 ASL R0
 ASL R0
 ADD #WORKERS,R0
 MOV R0,R4
 CALL JOB_AVAILABLE
 BCS 8$
 MOV INC_JOB,R0
 ASL R0
 MOV JOBS(R0),INC_COUNT
 BEQ 8$
 MOV 6(R4),INC_PTR
3$: MOV INC_PTR,R4
 MOV (R4)+,R5
 ; Validate inputs for one worker first; no partial consumption.
 MOV R4,-(SP)
 MOV R5,-(SP)
4$: MOV (R4)+,R0
 MOV (R4)+,R1
 BPL 5$
 NEG R1
 ASR R1
 CMP STORES(R0),R1
 BLT 7$
5$: SOB R5,4$
 MOV (SP)+,R5
 MOV (SP)+,R4
6$: MOV (R4)+,R0
 MOV (R4)+,R1
 ADD HALVES(R0),R1
 CLR HALVES(R0)
 BIT #1,R1
 BEQ 61$
 MOV #1,HALVES(R0)
61$: ASR R1
 MOV #STORES,R2
 CALL ADD_RESOURCE
 SOB R5,6$
 DEC INC_COUNT
 BNE 3$
 BR 8$
7$: TST (SP)+
 TST (SP)+
8$: INC INC_JOB
 CMP INC_JOB,#NWORK
 BLO 2$
 ; Thieves take a little from established settlements until confronted.
 CMP POPULATION,#20.
 BLO 10$
 TST FLAGS+F_THIEVES
 BNE 9$
 MOV #1,FLAGS+F_THIEVES
 MOV #S_THIEF,NOTICE
 CALL NOTIFY
9$: CMP FLAGS+F_THIEVES,#1
 BNE 10$
 TST STORES+R_WOOD
 BEQ 10$
 DEC STORES+R_WOOD
 INC STOLEN+R_WOOD
10$: RETURN
INC_JOB: .WORD 0
INC_COUNT: .WORD 0
INC_PTR: .WORD 0

VILLAGE_EVENT:
 CMP FLAGS+F_THIEVES,#1
 BNE 1$
 MOV #EV_GLOBAL_0,R0
 JMP START_EVENT
1$: CMP TAB,#1
 BEQ 5$
 MOV #10.,R1
 CALL RAND_N
 MOV R0,R4
 CMP R4,#7
 BLO 2$
 CMP R4,#9.
 BEQ 21$
 TST STORES+R_COMPASS
 BEQ 9$
 BR 4$
21$: TST STORES+R_MEDICINE
 BEQ 9$
 BR 4$
2$: CMP R4,#4
 BNE 3$
 CMP BUILDINGS+B_HUT,#5
 BLT 9$
 CMP BUILDINGS+B_HUT,#20.
 BGE 9$
3$: TST STORES+R_WOOD
 BEQ 9$
 CMP R4,#0
 BEQ 31$
 CMP R4,#3
 BEQ 31$
 CMP R4,#6
 BNE 4$
31$: TST STORES+R_FUR
 BEQ 9$
4$: ASL R4
 MOV ROOM_EVENTS(R4),R0
 JMP START_EVENT
5$: MOV #6,R1
 CALL RAND_N
 MOV R0,R4
 CMP R4,#0
 BNE 6$
 TST BUILDINGS+B_TRAP
 BEQ 9$
 BR 8$
6$: TST POPULATION
 BEQ 9$
 CMP R4,#1
 BNE 61$
 CMP POPULATION,#50.
 BLE 9$
61$: CMP R4,#2
 BLT 8$
 CMP R4,#3
 BGT 7$
 TST STORES+R_MEDICINE
 BEQ 9$
 CMP R4,#3
 BEQ 62$
 CMP POPULATION,#10.
 BLE 9$
 CMP POPULATION,#50.
 BGE 9$
 BR 7$
62$: CMP POPULATION,#50.
 BLE 9$
7$: CMP R4,#5
 BNE 8$
 TST FLAGS+F_CITYCLEARED
 BEQ 9$
8$: ASL R4
 MOV OUT_EVENTS(R4),R0
 JMP START_EVENT
9$: RETURN

FIRE_NOTIFY:
 MOV FIRE,R0
 ASL R0
 MOV FIRE_TEXT(R0),NOTICE
 CALL NOTIFY
 RETURN
