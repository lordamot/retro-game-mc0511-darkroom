; UI overlays use video plane 2; index 6 (both planes) is gray.
; All addresses are within the visible 100000..154777 video range.

; Record a frame around each usable numbered tab. Help remains plain text.
PUT_TAB:
 MOV CURSOR,-(SP)
 MOVB (R1),R0
 SUB #61,R0
 CMP R0,TAB
 BNE 1$
 CLR R0
 BR 2$
1$: MOV #1,R0
2$: MOV R0,-(SP)
 CALL PUTS
 MOV (SP)+,R0
 MOV (SP)+,R2
 TST AWAY
 BNE 9$
 TST ACTIVE_SCENE
 BNE 9$
 TST ENEMY_HP
 BNE 9$
 MOV TAB_END,R3
 MOV R0,4(R3)
 MOV CURSOR,R0
 SUB R2,R0
 MOV R0,2(R3) ; label plus its two side-padding cells
 CMP R2,#160.
 BLO 3$
 SUB #160.,R2
 ADD #100000+1920.,R2 ; row 2, unused first glyph scanline
 BR 4$
3$: SUB #80.,R2
 ADD #100000+960.,R2 ; row 1, unused first glyph scanline
4$: DEC R2
 MOV R2,(R3)
 ADD #6,TAB_END
9$: RETURN

; Compare composed frame records before erasing: ordinary redraws never blink.
TAB_UPDATE:
 MOV #TAB_NEXT,R0
 MOV #TAB_FRAMES,R1
 MOV #28.,R2
1$: CMP (R0)+,(R1)+
 BNE 2$
 SOB R2,1$
 RETURN
2$: MOV #1,TAB_CLEAR
 CALL TAB_PIXELS
 CLR TAB_CLEAR
 MOV #TAB_NEXT,R0
 MOV #TAB_FRAMES,R1
 MOV #28.,R2
3$: MOV (R0)+,(R1)+
 SOB R2,3$
 RETURN
TAB_PIXELS:
 MOV #TAB_FRAMES,R4
1$: TST (R4)
 BEQ 9$
 MOV (R4),R1
 MOV #12.,R3
2$: MOV 2(R4),R2
 MOV #200,R0
 CALL TAB_BYTE
 DEC R2
3$: CLR R0
 CMP R3,#12.
 BEQ 4$
 CMP R3,#1
 BEQ 4$
 INC R1
 BR 5$
4$: MOV #377,R0
 CALL TAB_BYTE
5$:
 DEC R2
 CMP R2,#1
 BHI 3$
 MOV #1,R0
 CALL TAB_BYTE
 ADD #80.,R1
 SUB 2(R4),R1
 SOB R3,2$
 ADD #6,R4
 BR 1$
9$: RETURN
TAB_BYTE:
 TST TAB_CLEAR
 BEQ 1$
 CLR R0
1$: MOV R0,R5
 SWAB R5
 TST 4(R4)
 BEQ 2$
 BIS R0,R5
2$: MOV R1,@#176640
 MOV R5,@#176642
 INC R1
 RETURN
TAB_END: .WORD TAB_NEXT
TAB_CLEAR: .WORD 0
TAB_FRAMES: .BLKW 28.
TAB_NEXT: .BLKW 28.

FOCUS_ERASE:
 MOV #FOCUS_OLD,R0
 MOV FOCUS_COUNT,R1
 BEQ 2$
1$: MOV (R0)+,@#176640
 CLRB @#176643
 SOB R1,1$
2$: CLR FOCUS_COUNT
 RETURN

FOCUS_DRAW:
 CALL FOCUS_ERASE
 TST FOCUS_LENGTH
 BEQ 9$
 ; Six adjacent pixels follow a 6x6 square inside the cell before the label.
 MOV FOCUS_ROW,R1
 MUL #12.,R1
 MOV R1,FOCUS_TOP
 CLR R0
 MOV FOCUS_PHASE,R1
 ASR R1
 ASR R1
 DIV #20.,R0
 MOV R1,R4
 MOV #FOCUS_OLD,R5
 MOV #6,FOCUS_POS
1$: CMP R4,#20.
 BLO 2$
 CLR R4
2$: MOVB FOCUS_RING(R4),R0
 MOV R0,R1
 BIC #177770,R0
 ASR R1
 ASR R1
 ASR R1
 ADD FOCUS_COLUMN,R0
 ADD FOCUS_TOP,R1
 CALL FOCUS_PIXEL
 INC R4
 DEC FOCUS_POS
 BNE 1$
 MOV #6,FOCUS_COUNT
9$: RETURN
; Packed y*8+x, clockwise, with each corner appearing exactly once.
FOCUS_RING: .BYTE 17.,18.,19.,20.,21.,22.,30.,38.,46.,54.
 .BYTE 62.,61.,60.,59.,58.,57.,49.,41.,33.,25.
 .EVEN

; Plot one overlay pixel, recording its byte for the next erase pass.
; R0=x, R1=y; preserves R4/R5 except advancing the saved-byte list.
FOCUS_PIXEL:
 MOV R0,R2
 BIC #177770,R2
 ASL R2
 MOV PIXEL_BITS(R2),R3
 ASR R0
 ASR R0
 ASR R0
 MUL #80.,R1
 ADD R0,R1
 ADD #100000,R1
 MOV R1,(R5)+
 MOV R1,@#176640
 BISB R3,@#176643
 RETURN
PIXEL_BITS: .WORD 1,2,4,10,20,40,100,200
FOCUS_LENGTH: .WORD 0
FOCUS_ROW: .WORD 0
FOCUS_COLUMN: .WORD 8.
FOCUS_TOP: .WORD 0
FOCUS_POS: .WORD 0

; R4 menu entry. Carry set when its number is replaced by a cooldown bar.
; Store live timer pointers, so fill advances between ordinary text redraws.
REGISTER_BAR:
 MOV #BAR_ACTIONS,R2
 MOV #4,R3
1$: CMP 2(R4),(R2)+
 BEQ 2$
 ADD #4,R2
 SOB R3,1$
 CMP 2(R4),#SHIP_UPGRADE
 BNE 3$
 CMP 4(R4),#2
 BNE 9$
 MOV #LAUNCH_CD,R0
 MOV #1200.,R1
 BR 5$
2$: MOV (R2)+,R0
 MOV (R2),R1
 BR 5$
3$: CMP 2(R4),#ATTACK
 BNE 9$
 MOV 4(R4),R0
 ASL R0
 MOV WEAPON_SPAN(R0),R1
 ADD #WEAPON_CD,R0
 TST R1
 BNE 5$
 MOV 4(R4),R1
 MUL #12.,R1
 MOV WEAPONS+6(R1),R1
5$: MOV MENU_LINE,R2
 ASL R2
 MOV R0,BAR_PTR(R2)
 MOV R1,BAR_MAX(R2)
 SEC
 RETURN
9$: CLC
 RETURN
BAR_ACTIONS:
 .WORD STOKE,STOKE_CD,100.
 .WORD GATHER,GATHER_CD,600.
 .WORD CHECK_TRAPS,TRAPS_CD,900.
 .WORD EMBARK,DEATH_CD,1200.

; Seven character cells, 56 individual pixels, three scanlines high.
; Fill = ceil(remaining * 56 / original duration), clamped at full width.
BARS_DRAW:
 CLR R4
1$: MOV R4,R2
 ASL R2
 MOV BAR_PTR(R2),R0
 BNE 2$
 TSTB BAR_USED(R4)
 BEQ 8$
 CLRB BAR_USED(R4)
 BR 4$
2$: MOVB #1,BAR_USED(R4)
 MOV BAR_MAX(R2),R3
 ; Enemy waits can restart between text redraws, including frenzy transitions.
 CMP R0,#ENEMY_CLOCK
 BNE 21$
 MOV ENEMY_SPAN,R3
21$: MOV (R0),R0
 CMP R0,R3
 BLO 3$
 MOV #56.,R0
 BR 4$
3$: MOV R3,R2
 DEC R2
 MUL #56.,R0
 ADD R2,R1
 ADC R0
 DIV R3,R0
4$: MOV #BAR_BITS,R1
 MOV #7,R2
5$: CMP R0,#8.
 BLO 6$
 MOVB #377,(R1)+
 SUB #8.,R0
 BR 7$
6$: MOV R0,R3
 ASL R3
 MOVB BAR_MASKS(R3),(R1)+
 CLR R0
7$: SOB R2,5$
 MOV R4,R1
 MUL #960.,R1
 ADD #100000+368.,R1
 MOV #3,R5
71$: MOV #BAR_BITS,R0
 MOV #7,R2
72$: MOV R1,@#176640
 MOVB (R0)+,@#176643
 INC R1
 SOB R2,72$
 ADD #73.,R1
 SOB R5,71$
8$: INC R4
 CMP R4,#24.
 BLO 1$
 RETURN
BAR_MASKS: .WORD 0,1,3,7,17,37,77,177
BAR_BITS: .BLKB 8.
BAR_PTR: .BLKW 24.
BAR_MAX: .BLKW 24.

; Shade visible crafting entries when cold, capped or lacking their live cost.
; Attribute bit 7 is part of the diff cache, so color-only changes redraw glyphs.
SHADE_RECIPE:
 CMP 2(R4),#CRAFT
 BNE 9$
 MOV 4(R4),R1
 MUL #16.,R1
 ADD #RECIPES,R1
 MOV R1,R4
 CMP TEMPERATURE,#1
 BLE 4$
 MOV 4(R4),R0
 MOV STORES(R0),R1
 TST 2(R4)
 BNE 1$
 MOV BUILDINGS(R0),R1
1$: CMP R1,#30000.
 BGE 4$
 TST 6(R4)
 BEQ 2$
 CMP R1,6(R4)
 BGE 4$
2$: CALL RECIPE_COST
 MOV #COST_BUFFER,R4
 MOV #STORES,R5
 CALL COST_TEST
 BCC 9$
4$: MOV MENU_LINE,R1
 MUL #80.,R1
 ADD #SCREEN_BUF+2,R1
 MOV #53.,R0
5$: BISB #200,(R1)+
 SOB R0,5$
9$: RETURN
