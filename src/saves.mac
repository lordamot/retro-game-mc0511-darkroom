; Five RT-11 files. The slot dialog freezes gameplay, not firmware/FDD time.
; UI buffers are scratch during I/O; a load stages and checks every word before
; changing game RAM. Hidden video rows hold the candidate, below rollback RAM.
SV_BUF = SCREEN_OLD
SV_HDR = SCREEN_BUF
SV_STAGE = 117000
SV_WORDS = <<STATE_END-STATE_START>/2>+1+512.+5582.
SV_DATA_BLOCKS = <SV_WORDS+255.>/256.
SV_BLOCKS = SV_DATA_BLOCKS+1

SV_OPEN:
 MOV R0,SV_MODE
 MOV CLOCK,SV_PHASE
 SUB LAST_CLOCK,SV_PHASE
 CMP SV_PHASE,#4
 BLOS 10$
 MOV #4,SV_PHASE
10$: CLR SV_SLOT
 CLR SV_ERROR
 MOV #SV_SLOTS,R4
 MOV #5,R5
1$: CALL SV_NAME
 .LOOKU #SV_AREA,#1,#SV_FILE
 BCS 2$
 MOV #1,(R4)
 BR 3$
2$: CLR (R4)
 CMPB @#52,#1 ; RT-11 LOOKUP: file not found
 BEQ 3$
 MOV #2,(R4)
3$: .PURGE #1
 ADD #2,R4
 INC SV_SLOT
 SOB R5,1$
 CLR SV_SLOT
 MOV CLOCK,LAST_CLOCK
 MOV #1,DIRTY
 RETURN
SV_INPUT:
 CMP R0,#004
 BEQ SV_CANCEL
 CMP R0,#006
 BEQ SV_CANCEL
 CMP R0,#010
 BNE 1$
 MOV #1,SV_MODE
 BR 5$
1$: CMP R0,#011
 BNE 2$
 MOV #2,SV_MODE
 BR 5$
2$: CMP R0,#154
 BNE 3$
 TST SV_SLOT
 BEQ 9$
 DEC SV_SLOT
 BR 5$
3$: CMP R0,#134
 BNE 4$
 CMP SV_SLOT,#4
 BEQ 9$
 INC SV_SLOT
 BR 5$
4$: CMP R0,#153
 BNE 9$
 CALL SV_NAME
 CMP SV_MODE,#1
 BEQ SV_LOAD
 JMP SV_SAVE
5$: CLR SV_ERROR
9$: RETURN
SV_CANCEL:
 CLR SV_MODE
 JMP SV_REFRESH
SV_RESUME:
 MOV CLOCK,LAST_CLOCK
 SUB SV_PHASE,LAST_CLOCK
 MOV KEY_SERIAL,LAST_KEY
 CLR REPEAT_CD
 MOV #1,DIRTY
 RETURN
SV_NAME:
 MOV SV_SLOT,R0
 ADD #^RAV1,R0
 MOV R0,SV_FILE+4
 RETURN

SV_SAVE:
 CALL SV_BUSY
 .ENTER #SV_AREA,#1,#SV_FILE,#SV_BLOCKS
 BCS SV_IOERR
 MOV SV_PHASE,SV_SUM
 CLR SV_SUM+2
 MOV #SV_REGIONS,SV_SEG
 CLR SV_LEFT
 MOV #1,SV_BLOCK
1$: MOV #SV_BUF,R3
 MOV #256.,R4
2$: CALL SV_GET
 MOV R0,(R3)+
 ADD R0,SV_SUM
 ADD SV_SUM,SV_SUM+2
 SOB R4,2$
 .WRITW #SV_AREA,#1,#SV_BUF,#256.,SV_BLOCK
 BCS SV_IOERR
 CALL SV_PROGRESS
 INC SV_BLOCK
 CMP SV_BLOCK,#SV_BLOCKS
 BLO 1$
 MOV #SV_HDR,R0
 MOV #256.,R1
3$: CLR (R0)+
 SOB R1,3$
 MOV #SV_MAGIC,R0
 MOV #SV_HDR,R1
 MOV #SV_HEAD_WORDS,R2
4$: MOV (R0)+,(R1)+
 SOB R2,4$
 MOV SV_SUM,SV_HDR+64.
 MOV SV_SUM+2,SV_HDR+66.
 MOV SV_PHASE,SV_HDR+68.
 .WRITW #SV_AREA,#1,#SV_HDR,#256.,#0
 BCS SV_IOERR
 .CLOSE #1
 BCS SV_IOERR
 INC SV_BLOCK
 CALL SV_PROGRESS
 CLR SV_MODE
 BR SV_REFRESH

; Sequential source stream: state, PRNG, current scene and expedition rollback.
SV_GET:
 TST SV_LEFT
 BNE 2$
 TST SV_SEG
 BEQ 9$
 MOV SV_SEG,R2
 MOV (R2)+,SV_PTR
 MOV (R2)+,SV_LEFT
 MOV (R2)+,SV_KIND
 MOV R2,SV_SEG
 TST SV_LEFT
 BNE 2$
 CLR SV_SEG
9$: CLR R0
 RETURN
2$: MOV SV_PTR,R2
 TST SV_KIND
 BNE 3$
 MOV (R2)+,R0
 BR 4$
3$: MOV R2,@#176640
 MOV @#176642,R0
 INC R2
4$: MOV R2,SV_PTR
 DEC SV_LEFT
 RETURN

SV_LOAD:
 CALL SV_BUSY
 .LOOKU #SV_AREA,#1,#SV_FILE
 BCS SV_IOERR
 CMP R0,#SV_BLOCKS
 BNE SV_BAD
 .READW #SV_AREA,#1,#SV_HDR,#256.,#0
 BCS SV_IOERR
 MOV #SV_MAGIC,R0
 MOV #SV_HDR,R1
 MOV #SV_HEAD_WORDS,R2
1$: CMP (R0)+,(R1)+
 BNE SV_BAD
 SOB R2,1$
 CMP SV_HDR+68.,#4
 BHI SV_BAD
 MOV SV_HDR+64.,SV_EXPECT
 MOV SV_HDR+66.,SV_EXPECT+2
 MOV SV_HDR+68.,SV_LOAD_PHASE
 MOV SV_LOAD_PHASE,SV_SUM
 CLR SV_SUM+2
 MOV #1,SV_HIDE
2$: CMP SV_ACK,#1
 BNE 2$
 MOV #SV_STAGE,SV_VIDEO
 MOV #1,SV_BLOCK
3$: .READW #SV_AREA,#1,#SV_BUF,#256.,SV_BLOCK
 BCS SV_IOERR
 MOV #SV_BUF,R3
 MOV #256.,R4
4$: MOV (R3)+,R0
 ADD R0,SV_SUM
 ADD SV_SUM,SV_SUM+2
 MOV SV_VIDEO,@#176640
 MOV R0,@#176642
 CALL SV_ADVANCE
 SOB R4,4$
 CALL SV_PROGRESS
 INC SV_BLOCK
 CMP SV_BLOCK,#SV_BLOCKS
 BLO 3$
 CMP SV_SUM,SV_EXPECT
 BNE SV_BAD
 CMP SV_SUM+2,SV_EXPECT+2
 BNE SV_BAD
 ; Validation succeeded. This memory-only commit cannot encounter disk errors.
 MOV #SV_STAGE,SV_VIDEO
 MOV #SV_REGIONS,R4
5$: MOV (R4)+,R1
 MOV (R4)+,R2
 MOV (R4)+,R3
 TST R2
 BEQ 8$
6$: MOV SV_VIDEO,@#176640
 MOV @#176642,R0
 CALL SV_ADVANCE
 TST R3
 BNE 7$
 MOV R0,(R1)+
 BR 71$
7$: MOV R1,@#176640
 MOV R0,@#176642
 INC R1
71$: SOB R2,6$
 BR 5$
8$: MOV SV_LOAD_PHASE,SV_PHASE
 CLR NOTICE ; menus and notice pointers are rebuilt, never reused from a file
 INC SV_BLOCK
 CALL SV_PROGRESS
 CLR SV_MODE
 BR SV_REFRESH
SV_BAD:
 MOV #S_SAVE_BAD,SV_ERROR
 BR SV_REFRESH
SV_IOERR:
 MOV #S_SAVE_IO,SV_ERROR
SV_REFRESH:
 .PURGE #1
 CALL SV_CLEAR
 CLR SV_HIDE
5$: TST SV_ACK
 BNE 5$
 JMP SV_RESUME
SV_CLEAR:
 ; Discard all overlays/cache, including the candidate staged in visible video.
 MOV #100000,R0
 MOV #23040.,R1
1$: MOV R0,@#176640
 CLR @#176642
 INC R0
 SOB R1,1$
 CLR FOCUS_COUNT
 MOV #TAB_FRAMES,R0
 MOV #28.,R1
2$: CLR (R0)+
 SOB R1,2$
 MOV #BAR_USED,R0
 MOV #12.,R1
3$: CLR (R0)+
 SOB R1,3$
 MOV #SCREEN_OLD,R0
 MOV #960.,R1
 ; The cleared planes already match spaces; do not rasterize 1,920 blanks.
4$: MOV #20040,(R0)+
 SOB R1,4$
 RETURN

; Walk hidden rows only: row 8, rows 15..22, then rows 0..7.
; Keep the centered progress window and version footer untouched.
SV_ADVANCE:
 INC SV_VIDEO
 CMP SV_VIDEO,#100000+<9.*960.>
 BNE 1$
 MOV #100000+<15.*960.>,SV_VIDEO
1$: CMP SV_VIDEO,#100000+<23.*960.>
 BNE 2$
 MOV #100000,SV_VIDEO
2$: RETURN

; Paint before the first monitor request: no stale picker or active controls.
; Both text buffers become disk scratch, so progress writes video directly.
SV_BUSY:
 CALL SV_CLEAR
 CALL SCREEN_CLEAR
 MOV #34.,R0
 CMP SV_MODE,#1
 BEQ 2$
 DEC R0
2$: MOV #10.,R1
 CALL AT
 MOV #S_SAVE_READING,R1
 CMP SV_MODE,#1
 BEQ 1$
 MOV #S_SAVE_WRITING,R1
1$: CALL PUTS
 CALL DRAW_VERSION
 CALL FLUSH
 MOV #100000+<108.*80.>+16.,R1
 MOV #72.,R3
 MOV #47.,R4
 CALL FRAME_RECT
 CLR SV_BLOCK
 JMP SV_PROGRESS

; Centered outline at x=144..495, y=156..165, outside load staging.
; 336 individual fill pixels track completed data blocks. Reserve the final
; portion for header/CLOSE or validation/commit; only success reaches full.
; All registers are scratch; callers restart their block/region loops.
SV_PROGRESS:
 MOV SV_BLOCK,R0
 MUL #336.,R0
 DIV #SV_BLOCKS+1,R0
 MOV #100000+<156.*80.>+18.,R1
 MOV #44.,R2
1$: MOV #1,R3
 CMP R2,#44.
 BEQ 4$
 MOV #200,R3
 CMP R2,#1
 BEQ 4$
 MOV #377,R3
 CMP R0,#8.
 BLO 2$
 SUB #8.,R0
 BR 4$
2$: MOV R0,R3
 ASL R3
 MOV BAR_MASKS(R3),R3
 CLR R0
4$: MOV R1,R4
 MOV R4,@#176640
 MOVB #377,@#176642
 MOV #8.,R5
5$: ADD #80.,R4
 MOV R4,@#176640
 MOVB R3,@#176642
 SOB R5,5$
 ADD #80.,R4
 MOV R4,@#176640
 MOVB #377,@#176642
 INC R1
 SOB R2,1$
 RETURN

SV_DRAW:
 CALL SCREEN_CLEAR
 CALL LOG_WHITE
 MOV #18.,R0
 MOV #7,R1
 CALL AT
 MOV #S_SAVE_LOAD,R1
 CMP SV_MODE,#1
 BEQ 2$
 MOV #S_SAVE_SAVE,R1
2$: CALL PUTS
 CLR SV_ROW
3$: MOV #18.,R0
 MOV SV_ROW,R1
 ADD #9.,R1
 CALL AT
 MOV SV_ROW,R0
 INC R0
 CALL NUMBER
 MOV #40,R0
 CALL PUTCHAR
 MOV SV_ROW,R0
 ASL R0
 MOV SV_SLOTS(R0),R0
 ASL R0
 MOV SV_SLOT_TEXT(R0),R1
 CALL PUTS
 INC SV_ROW
 CMP SV_ROW,#5
 BLO 3$
 MOV SV_SLOT,R0
 ADD #9.,R0
 MOV R0,FOCUS_ROW
 MOV #1,FOCUS_LENGTH
 MOV #136.,FOCUS_COLUMN
 MOV #18.,R0
 MOV #15.,R1
 CALL AT
 MOV SV_ERROR,R1
 BEQ 4$
 CALL PUTS
4$: MOV #18.,R0
 MOV #16.,R1
 CALL AT
 MOV #S_SAVE_HINT,R1
 CALL PUTS
 JMP DRAW_VERSION
; 1-pixel frame around the modal, outside all text/spinner cells.
SV_FRAME:
 TST SV_MODE
 BNE 1$
 TST TR_MODE
 BEQ 9$
1$: MOV #100000+<71.*80.>+16.,R1
 MOV #146.,R3
 MOV #47.,R4
 CALL FRAME_RECT
 TST SV_MODE
 BNE 9$
 ; Button borders use blank scanlines outside all eleven ROM glyph rows.
 MOV #100000+<191.*80.>+35.,R1
 MOV #14.,R3
 MOV #9.,R4
 JMP FRAME_RECT
9$: RETURN
; R1 upper-left video byte, R3 scanline height, R4 right edge byte distance.
FRAME_RECT:
 MOV R3,R5
1$: MOV R1,@#176640
 MOVB #1,@#176643
 MOV R1,R0
 ADD R4,R0
 MOV R0,@#176640
 MOVB #200,@#176643
 CMP R3,R5
 BEQ 2$
 CMP R3,#1
 BNE 4$
2$: MOV R4,R2
 INC R2
 MOV R1,R0
3$: MOV R0,@#176640
 MOVB #377,@#176643
 INC R0
 SOB R2,3$
4$: ADD #80.,R1
 SOB R3,1$
9$: RETURN

SV_MODE: .WORD 0
SV_SLOT: .WORD 0
SV_PHASE: .WORD 0
SV_ERROR: .WORD 0
SV_SLOTS: .BLKW 5
SV_ROW: .WORD 0
SV_HIDE: .WORD 0
SV_ACK: .WORD 0
SV_FILE: .RAD50 /DK DRSAV1DAT/
SV_AREA: .BLKW 10
SV_SEG: .WORD 0
SV_PTR: .WORD 0
SV_LEFT: .WORD 0
SV_KIND: .WORD 0
SV_BLOCK: .WORD 0
SV_VIDEO: .WORD 0
SV_SUM: .BLKW 2
SV_EXPECT: .BLKW 2
SV_LOAD_PHASE: .WORD 0
SV_SLOT_TEXT: .WORD S_SAVE_EMPTY,S_SAVE_USED,S_SAVE_UNKNOWN
SV_REGIONS: .WORD STATE_START,<STATE_END-STATE_START>/2,0
 .WORD SEED,1,0,SCENE_BASE,512.,0
 .WORD 155000,5582.,1,0,0,0
SV_MAGIC: .WORD 42504,52523,1,SV_BLOCKS,SV_WORDS
 .INCLUDE build/save-id.mac
SV_HEAD_END:
SV_HEAD_WORDS = <SV_HEAD_END-SV_MAGIC>/2
