; Disk scene engine. Header layout is emitted by tools/generate.py.
START_EVENT:
 MOV TAB,EVENT_RETURN
 MOV #1,ACTIVE_SCENE
 MOV R0,SCENE_ID
 MOV #13.,TAB
 CLR SELECTED
 JMP LOAD_SCENE
LOAD_SCENE:
 MOV SCENE_ID,R0
 CALL DISK_READ
 MOV @#SCENE_BASE+4,ENEMY_HP
 MOV @#SCENE_BASE+8.,ENEMY_CLOCK
 MOV ENEMY_CLOCK,ENEMY_SPAN
 CLR ENEMY_STUN
 CLR SPECIAL_CLOCK
 CLR ENEMY_STATUS
 CLR STATUS_TIME
 CLR LAST_SPECIAL
 CLR POISON
 CLR MEDITATE
 CLR EXPLODE_TIME
 CLR SHIELD_TIME
 CLR STIM_TIME
 MOV #S_READY,NOTICE
 CALL NOTIFY
 MOV #LOOT,R0
 MOV #NRES,R1
1$: CLR (R0)+
 SOB R1,1$
 MOV @#SCENE_BASE+14.,R4
 CALL EFFECTS
 TST ENEMY_HP
 BEQ 3$
 MOV #1,R0
 JMP TR_OPEN
3$:
 CALL ROLL_LOOT
2$: MOV #1,DIRTY
 CLR SELECTED
 RETURN
END_EVENT:
 CLR ACTIVE_SCENE
 CLR ENEMY_HP
 MOV EVENT_RETURN,TAB
 CLR SELECTED
 MOV #S_READY,NOTICE
 CALL NOTIFY
 RETURN

ROLL_LOOT:
 MOV @#SCENE_BASE+12.,R4
 MOV (R4)+,R5
 BEQ 9$
1$: MOV #100.,R1
 CALL RAND_N
 CMP R0,6(R4)
 BHIS 3$
 MOV 4(R4),R1
 SUB 2(R4),R1
 INC R1
 CALL RAND_N
 ADD 2(R4),R0
 MOV (R4),R2
 MOV R0,LOOT(R2)
3$: ADD #8.,R4
 SOB R5,1$
9$: RETURN

; R4 choice record: text,cost,effects,branches,condition,index.
CHOICE_AVAILABLE:
 MOV 8.(R4),R0
 BEQ 8$
 MOV 10.(R4),R1
 CMP R0,#1
 BNE 1$
 TST STORES(R1)
 BEQ 8$
 BR 9$
1$: CMP R0,#2
 BNE 2$
 TST PERKS(R1)
 BEQ 8$
 BR 9$
2$: CMP R0,#3
 BNE 3$
 TST FLAGS(R1)
 BEQ 8$
 BR 9$
3$: CMP R0,#5
 BNE 31$
 CALL MAP_COMPLETE
 RETURN
31$: TST FLAGS+F_ENGINEERING
 BEQ 9$
 TST FLAGS+F_MEDICAL
 BEQ 9$
 TST FLAGS+F_MARTIAL
 BEQ 9$
8$: CLC
 RETURN
9$: SEC
 RETURN
CHOOSE:
 MOV R0,CHOICE_PTR
 MOV R0,R4
 CALL CHOICE_AVAILABLE
 BCS 9$
 MOV #STORES,R5
 TST AWAY
 BEQ 1$
 MOV #BAG,R5
 MOV WATER,BAG+R_WATER
 MOV HP,BAG+R_HP
1$: MOV 2(R4),R4
 CALL SCENE_COST
 CALL COST_TEST
 BCS 8$
 CALL COST_PAY
 TST AWAY
 BEQ 2$
 MOV BAG+R_WATER,WATER
 MOV BAG+R_HP,HP
 CLR BAG+R_WATER
 CLR BAG+R_HP
2$: MOV CHOICE_PTR,R4
 MOV 4(R4),R4
 CALL EFFECTS
 MOV CHOICE_PTR,R4
 MOV 6(R4),R4
 MOV (R4)+,R5
 MOV #100.,R1
 CALL RAND_N
 INC R0
3$: CMP R0,(R4)+
 BLE 4$
 TST (R4)+
 SOB R5,3$
4$: MOV (R4),R0
 TST HP
 BGT 41$
 JMP DIE
41$: CMP R0,#-1
 BNE 5$
 JMP END_EVENT
5$: CMP R0,SCENE_ID
 BEQ 9$
 MOV R0,SCENE_ID
 JMP LOAD_SCENE
8$: CLR BAG+R_WATER
 CLR BAG+R_HP
 JMP CANT_MSG
9$: RETURN
CHOICE_PTR: .WORD 0

; Compact effect triples. R4 pointer. Every effect preserves the stream.
EFFECTS:
 MOV (R4)+,R5
 BEQ 9$
1$: MOV (R4)+,R0
 MOV (R4)+,R1
 MOV (R4)+,R2
 MOV R4,-(SP)
 MOV R5,-(SP)
 ASL R0
 CALL @EFFECT_TABLE(R0)
 MOV (SP)+,R5
 MOV (SP)+,R4
 SOB R5,1$
9$: RETURN
EFFECT_TABLE: .WORD E_NO,CLEAR_DUNGEON,MARK_VISITED,E_WATER,DRAW_ROAD,E_FLAG,E_PERK,E_HP,APPLY_MAP,E_ADD,E_BEGGAR,E_HUT,E_GAMBLE,E_TRAP,E_FIRE,E_KILL,E_THIEF
E_NO: RETURN
E_WATER:
 MOV MAX_WATER,WATER
 JMP MARK_VISITED
E_FLAG:
 MOV R2,FLAGS(R1)
 RETURN
E_PERK:
 MOV #1,PERKS(R1)
 RETURN
E_HP:
 MOV MAX_HP,HP
 RETURN
E_ADD:
 MOV R1,R0
 MOV R2,R1
 MOV #STORES,R2
 TST AWAY
 BEQ 1$
 MOV #BAG,R2
1$: JMP ADD_RESOURCE
E_HUT:
 CMP BUILDINGS+B_HUT,#20.
 BGE 1$
 INC BUILDINGS+B_HUT
1$: RETURN
E_BEGGAR:
 MOV R1,R4
 MOV STORES+R_WOOD,R1
 CLR R0
 DIV #10.,R0
 TST R0
 BNE 1$
 INC R0
1$: SUB R0,STORES+R_WOOD
 BPL 2$
 CLR STORES+R_WOOD
2$: MOV R0,R1
 CLR R0
 DIV #5,R0
 TST R0
 BNE 3$
 INC R0
3$: MOV R0,R1
 MOV R4,R0
 MOV #STORES,R2
 JMP ADD_RESOURCE
E_GAMBLE:
 MOV R1,GAMBLE_RES
 MOV R2,R4
 MOV #100.,R1
 CALL RAND_N
 MOV #50.,R2
 CMP R4,#100.
 BEQ 1$
 MOV #30.,R2
1$: CMP R0,R2
 BHIS 9$
 MOV R4,R1
 MUL #3,R1
 MOV R1,GAMBLE_AMOUNT
 MOV #60.,GAMBLE_TIME
9$: RETURN
E_TRAP:
 MOV BUILDINGS+B_TRAP,R1
 BEQ 9$
 CALL RAND_N
 INC R0
 SUB R0,BUILDINGS+B_TRAP
9$: RETURN
E_FIRE:
 TST BUILDINGS+B_HUT
 BEQ E_NO
 DEC BUILDINGS+B_HUT
 MOV BUILDINGS+B_HUT,R1
 ASL R1
 ASL R1
 MOV POPULATION,R0
 SUB R1,R0
 BLE E_NO
 BR KILL_PEOPLE
E_KILL:
 TST R1
 BNE 1$
 MOV POPULATION,R1
 ASR R1
1$: TST R1
 BNE 2$
 INC R1
2$: MOV R2,-(SP)
 CALL RAND_N
 ADD (SP)+,R0
KILL_PEOPLE:
 SUB R0,POPULATION
 BPL 3$
 CLR POPULATION
3$: CALL FREE_WORKERS
 TST R0
 BGE 9$
 MOV #JOBS+2,R1
 MOV #NWORK-1,R2
4$: TST (R1)
 BEQ 5$
 DEC (R1)
 BR 3$
5$: TST (R1)+
 SOB R2,4$
9$: RETURN
E_THIEF:
 MOV #2,FLAGS+F_THIEVES
 TST R1
 BEQ 9$
 CLR R4
1$: MOV R4,R0
 MOV STOLEN(R4),R1
 CLR STOLEN(R4)
 MOV #STORES,R2
 CALL ADD_RESOURCE
 ADD #2,R4
 CMP R4,#NRES*2
 BLO 1$
9$: RETURN


SCENE_COST:
 MOV (R4)+,R0
 MOV #CHOICE_COST,R1
 MOV R0,(R1)+
1$: TST R0
 BEQ 3$
 MOV (R4)+,R2
 MOV R2,(R1)+
 MOV (R4)+,R3
 CMP R2,#R_TORCH
 BNE 2$
 TST BAG+R_GLOWSTONE
 BEQ 2$
 CLR R3
2$: MOV R3,(R1)+
 DEC R0
 BR 1$
3$: MOV #CHOICE_COST,R4
 RETURN
CHOICE_COST: .BLKW 17.

; Original weapon damage, individual cooldowns, ammunition, perks and buffs.
; C set if an equipped damaging weapon still has ammunition.
ARMED:
 MOV R4,-(SP)
 MOV R5,-(SP)
 MOV #WEAPONS+12.,R4
 MOV #NWEAP-1,R5
1$: TST 4(R4)
 BMI 3$
 MOV 2(R4),R0
 TST BAG(R0)
 BEQ 3$
 MOV 8.(R4),R0
 BMI 2$
 TST BAG(R0)
 BEQ 3$
2$: MOV (SP)+,R5
 MOV (SP)+,R4
 SEC
 RETURN
3$: ADD #12.,R4
 SOB R5,1$
 MOV (SP)+,R5
 MOV (SP)+,R4
 CLC
 RETURN
ATTACK:
 TST R0
 BNE 0$
 CALL ARMED
 BCS 9$
 CLR R0
0$: TST ENEMY_HP
 BEQ 9$
 MOV R0,ATT_INDEX
 ASL R0
 TST WEAPON_CD(R0)
 BNE 9$
 MOV ATT_INDEX,R1
 MUL #12.,R1
 ADD #WEAPONS,R1
 MOV R1,R4
 MOV 2(R4),R0
 BMI 1$
 TST BAG(R0)
 BEQ 9$
1$: MOV 8.(R4),R0
 BMI 2$
 TST BAG(R0)
 BEQ 9$
 DEC BAG(R0)
2$: MOV ATT_INDEX,R0
 ASL R0
 MOV 6(R4),R2
 TST ATT_INDEX
 BNE 21$
 TST PERKS+P_UNARMED_MASTER
 BEQ 21$
 ASR R2
21$: TST STIM_TIME
 BEQ 22$
 ASR R2
 BNE 22$
 INC R2
22$: MOV R2,WEAPON_CD(R0)
 MOV R2,WEAPON_SPAN(R0)
 TST ATT_INDEX
 BNE 23$
 INC PUNCHES
 CMP PUNCHES,#50.
 BLO 23$
 MOV #1,PERKS+P_BOXER
 CMP PUNCHES,#150.
 BLO 23$
 MOV #1,PERKS+P_MARTIAL_ARTIST
 CMP PUNCHES,#300.
 BLO 23$
 MOV #1,PERKS+P_UNARMED_MASTER
23$: MOV #100.,R1
 CALL RAND_N
 MOV #80.,R2
 TST PERKS+P_PRECISE
 BEQ 3$
 MOV #90.,R2
3$: CMP R0,R2
 BLO 4$
 MOV #S_MISS,NOTICE
 CALL NOTIFY
 RETURN
4$: MOV 4(R4),R0
 BPL 5$
 MOV #40.,ENEMY_STUN
 MOV #S_STUN,NOTICE
 CALL NOTIFY
 RETURN
5$: TST ATT_INDEX
 BNE 6$
 TST PERKS+P_BOXER
 BEQ 51$
 ASL R0
51$: TST PERKS+P_MARTIAL_ARTIST
 BEQ 52$
 MOV R0,R1
 ASL R0
 ADD R1,R0
52$: TST PERKS+P_UNARMED_MASTER
 BEQ 6$
 ASL R0
6$: TST 10.(R4)
 BEQ 7$
 TST PERKS+P_BARBARIAN
 BEQ 7$
 MOV R0,R1
 ASR R1
 ADD R1,R0
7$: CMP ENEMY_STATUS,#2
 BNE 71$
 ADD R0,ENEMY_HP
 CMP ENEMY_HP,@#SCENE_BASE+4
 BLE 70$
 MOV @#SCENE_BASE+4,ENEMY_HP
70$: CLR ENEMY_STATUS
 RETURN
71$: CMP ENEMY_STATUS,#5
 BNE 72$
 ADD R0,MEDITATE
 RETURN
72$: MOV ENEMY_HP,R1
 SUB R0,ENEMY_HP
 CMP @#SCENE_BASE+18.,#1
 BNE 73$
 CMP R1,#40.
 BLE 73$
 CMP ENEMY_HP,#40.
 BGT 73$
 MOV #1,ENEMY_STATUS
73$: TST ENEMY_HP
 BGT 8$
 CLR ENEMY_HP
 CLR POISON
 TST @#SCENE_BASE+24.
 BEQ FIGHT_WON
 MOV #30.,EXPLODE_TIME
 MOV #S_EXPLODING,NOTICE
 CALL NOTIFY
 RETURN
8$: MOV #S_HIT,NOTICE
 CALL NOTIFY
9$: RETURN
FIGHT_WON:
 CALL ROLL_LOOT
 CLR SELECTED
 MOV #S_VICTORY,NOTICE
 CALL NOTIFY
 MOV #1,DIRTY
 RETURN
ATT_INDEX: .WORD 0
AUTO_ATTACK:
 ; Prefer an equipped weapon over fists; skip weapons with no ammunition.
 MOV #1,AUTO_INDEX
1$: MOV AUTO_INDEX,R0
 ASL R0
 TST WEAPON_CD(R0)
 BNE 3$
 MOV AUTO_INDEX,R1
 MUL #12.,R1
 MOV WEAPONS+2(R1),R0
 TST BAG(R0)
 BEQ 3$
 MOV WEAPONS+8.(R1),R0
 BMI 2$
 TST BAG(R0)
 BEQ 3$
2$: MOV AUTO_INDEX,R0
 JMP ATTACK
3$: INC AUTO_INDEX
 CMP AUTO_INDEX,#NWEAP
 BLO 1$
 CLR R0
 JMP ATTACK
AUTO_INDEX: .WORD 0
COMBAT_TICK:
 TST STIM_TIME
 BEQ 1$
 DEC STIM_TIME
1$: TST STATUS_TIME
 BEQ 2$
 DEC STATUS_TIME
 BNE 2$
 CLR ENEMY_STATUS
2$: TST POISON
 BEQ 3$
 INC POISON_CLOCK
 CMP POISON_CLOCK,#10.
 BLO 3$
 CLR POISON_CLOCK
 SUB POISON,HP
 TST HP
 BLE COMBAT_DIE
 MOV #1,DIRTY
3$: TST @#SCENE_BASE+22.
 BEQ 4$
 INC SPECIAL_CLOCK
 CMP SPECIAL_CLOCK,@#SCENE_BASE+22.
 BLO 4$
 CLR SPECIAL_CLOCK
 MOV @#SCENE_BASE+18.,R0
 CMP R0,#6
 BNE 31$
30$: MOV #3,R1
 CALL RAND_N
 ASL R0
 MOV BOSS_STATUSES(R0),R0
 CMP R0,LAST_SPECIAL
 BEQ 30$
 MOV R0,LAST_SPECIAL
31$: MOV R0,ENEMY_STATUS
 CLR STATUS_TIME
 CMP R0,#4
 BNE 32$
 MOV #40.,STATUS_TIME
 MOV #5,ENEMY_CLOCK
 MOV ENEMY_CLOCK,ENEMY_SPAN
32$: CMP R0,#5
 BNE 4$
 MOV #50.,STATUS_TIME
 CLR MEDITATE
4$: TST ENEMY_STUN
 BEQ 5$
 DEC ENEMY_STUN
 BNE 41$
 MOV #1,DIRTY ; remove the stun label as soon as attacks can resume
41$:
 RETURN
5$: CMP ENEMY_STATUS,#5
 BEQ E_NO
 DEC ENEMY_CLOCK
 BGT E_NO
 MOV @#SCENE_BASE+8.,ENEMY_CLOCK
 CMP ENEMY_STATUS,#4
 BNE 51$
 MOV #5,ENEMY_CLOCK
51$: MOV ENEMY_CLOCK,ENEMY_SPAN
 TST MEDITATE
 BEQ 6$
 MOV MEDITATE,R0
 CLR MEDITATE
 BR ENEMY_DAMAGE
6$: MOV #100.,R1
 CALL RAND_N
 MOV @#SCENE_BASE+10.,R2
 TST PERKS+P_EVASIVE
 BEQ 61$
 MOV R0,R4
 MOV R2,R1
 CLR R0
 DIV #5,R0
 SUB R0,R2
 MOV R4,R0
61$: CMP R0,R2
 BLO 611$
 MOV #S_ENEMY_MISS,NOTICE
 CALL NOTIFY
 RETURN
611$:
 MOV @#SCENE_BASE+6,R0
 CMP ENEMY_STATUS,#3
 BNE 62$
 ASL R0
 ASL R0
 CLR ENEMY_STATUS
62$: CMP ENEMY_STATUS,#1
 BNE ENEMY_DAMAGE
 TST SHIELD_TIME
 BNE ENEMY_DAMAGE
 MOV R0,POISON
 ASR POISON
 CLR POISON_CLOCK
 CLR ENEMY_STATUS
ENEMY_DAMAGE:
 TST SHIELD_TIME
 BEQ 1$
 ADD R0,HP
 CMP HP,MAX_HP
 BLE 0$
 MOV MAX_HP,HP
0$: CLR SHIELD_TIME
 BR 2$
1$: SUB R0,HP
2$: MOV #S_HURT,NOTICE
 CALL NOTIFY
 MOV #1,DIRTY
 TST HP
 BLE COMBAT_DIE
9$: RETURN
COMBAT_DIE:
 JMP DIE
BOSS_STATUSES: .WORD 2,4,5
EXPLOSION:
 MOV @#SCENE_BASE+24.,R0
 CALL ENEMY_DAMAGE
 TST ACTIVE_SCENE
 BEQ 9$
 JMP FIGHT_WON
9$: RETURN

; R0: food, medicine, hypo, kinetic shield, stimulant. Shield/stim are abilities.
HEAL:
 MOV R0,R4
 ASL R4
 TST HEAL_CD(R4)
 BNE 9$
 CMP R4,#6
 BNE 1$
 TST STORES+R_KINETIC_ARMOUR
 BEQ 9$
 MOV #1,SHIELD_TIME
 MOV #100.,SHIELD_CD
 RETURN
1$: MOV HEAL_ITEMS(R4),R0
 TST BAG(R0)
 BEQ 9$
 CMP R4,#8.
 BNE 2$
 MOV #30.,STIM_TIME
 MOV #100.,STIM_CD
 SUB #10.,HP
 TST HP
 BLE COMBAT_DIE
 RETURN
2$: DEC BAG(R0)
 MOV #70.,HEAL_CD(R4)
 MOV HEAL_AMOUNTS(R4),R0
 TST R4
 BNE 3$
 MOV #50.,HEAL_CD
 TST PERKS+P_GASTRONOME
 BEQ 3$
 ASL R0
3$: ADD R0,HP
 CMP HP,MAX_HP
 BLE 9$
 MOV MAX_HP,HP
9$: RETURN
HEAL_ITEMS: .WORD R_CURED_MEAT,R_MEDICINE,R_HYPO,R_KINETIC_ARMOUR,R_STIM
HEAL_AMOUNTS: .WORD 8.,20.,30.,0,0
