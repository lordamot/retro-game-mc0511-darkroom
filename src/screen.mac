; 80 x 24 logical characters, 8x11 glyphs on a 12 scanline pitch.
; Compose in RAM and only draw changed characters: no full-screen flicker.
SCREEN_CLEAR:
 MOV #TAB_NEXT,R0
 MOV R0,TAB_END
 MOV #28.,R1
0$: CLR (R0)+
 SOB R1,0$
 MOV #SCREEN_BUF,R0
 MOV #960.,R1
1$: MOV #20040,(R0)+
 SOB R1,1$
 MOV #BAR_PTR,R0
 MOV #24.,R1
3$: CLR (R0)+
 SOB R1,3$
 MOV #8.,FOCUS_COLUMN
 CLR FOCUS_LENGTH
 CLR CURSOR
 RETURN
; R0 column, R1 logical row.
AT:
 MUL #80.,R1
 ADD R0,R1
 MOV R1,CURSOR
 RETURN
; R1 nul-terminated KOI-7 string. Preserves R2..R5.
PUTS:
 MOV R0,-(SP)
 MOV R2,-(SP)
 MOV CURSOR,R2
1$: MOVB (R1)+,R0
 BEQ 3$
 CMP R0,#12
 BNE 2$
 ; newline uses next full row
 MOV R1,-(SP)
 MOV R2,R1
 CLR R0
 DIV #80.,R0
 INC R0
 MUL #80.,R0
 MOV R1,R2
 MOV (SP)+,R1
 BR 1$
2$: CMP R2,#1920.
 BHIS 3$
 MOVB R0,SCREEN_BUF(R2)
 INC R2
 BR 1$
3$: MOV R2,CURSOR
 MOV (SP)+,R2
 MOV (SP)+,R0
 RETURN
PUTCHAR:
 MOV R1,-(SP)
 MOV CURSOR,R1
 CMP R1,#1920.
 BHIS 1$
 MOVB R0,SCREEN_BUF(R1)
 INC CURSOR
1$: MOV (SP)+,R1
 RETURN
NUMBER:
 MOV R1,-(SP)
 MOV R2,-(SP)
 MOV #NUMBUF+6,R2
 CLRB (R2)
 MOV R0,R1
1$: CLR R0
 DIV #10.,R0
 ADD #60,R1
 MOVB R1,-(R2)
 MOV R0,R1
 BNE 1$
 MOV R2,R1
 CALL PUTS
 MOV (SP)+,R2
 MOV (SP)+,R1
 RETURN
FLUSH:
 MOV #SCREEN_BUF,R4
 MOV #SCREEN_OLD,R5
 MOV #100000,DRAW_ROW
 MOV #24.,DRAW_ROWS
1$: MOV #80.,DRAW_COLS
 MOV DRAW_ROW,DRAW_ADDR
2$: MOVB (R4)+,R0
 CMPB R0,(R5)+
 BEQ 4$
 MOVB R0,-1(R5)
 MOV R0,DRAW_SHADE
 BIC #177600,R0
 SUB #40,R0
 CMP R0,#FONT_LAST-FONT_FIRST+1
 BLO 3$
 CLR R0
3$: MUL #FONT_HEIGHT,R0
 MOV R1,R0 ; even-register MUL puts the low product in R1
 ADD #FONT,R0
 MOV DRAW_ADDR,R1
 MOV #FONT_HEIGHT,R2
31$: MOV R1,@#176640
 MOVB (R0)+,@#176642
 CLRB @#176643
 TSTB DRAW_SHADE
 BPL 32$
 MOVB -1(R0),@#176643
32$:
 ADD #80.,R1
 SOB R2,31$
4$: INC DRAW_ADDR
 DEC DRAW_COLS
 BNE 2$
 ADD #960.,DRAW_ROW
 DEC DRAW_ROWS
 BNE 1$
 RETURN
; Right-aligned footer, including Help, endings and the save/load window.
DRAW_VERSION:
 MOV #80.-GAME_VERSION_LENGTH,R0
 MOV #23.,R1
 CALL AT
 ; Latin capitals occupy the separate 140..177 font bank.
 MOVB @#GAME_VERSION,R0
 ADD #40,R0
 CALL PUTCHAR
 MOV #GAME_VERSION+1,R1
 JMP PUTS
CURSOR: .WORD 0
DRAW_SHADE: .WORD 0
DRAW_ROW: .WORD 0
DRAW_ADDR: .WORD 0
DRAW_ROWS: .WORD 0
DRAW_COLS: .WORD 0
NUMBUF: .BLKB 8.
SCREEN_BUF: .BLKB 1920.
SCREEN_OLD: .BLKB 1920.
