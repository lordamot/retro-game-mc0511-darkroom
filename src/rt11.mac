; RT-11 SJ entry, file I/O and cooperative return. No raw floppy assumptions.
RT_ENTRY:
 MOV SP,RT_OLDSP
 .SETTO #STACK_TOP
 CMP R0,#STACK_TOP
 BLO RT_NOMEM
 MOV #STACK_TOP,SP
 .LOOKU #RT_AREA,#0,#RT_FILE
 BCS RT_NOFILE
 CMP R0,#SCENE_BLOCKS
 BNE RT_BADFILE
 .READW #RT_AREA,#0,#SCENE_BASE,#256.,#0
 BCS RT_EARLYIO
 MOV #DATA_HEADER,R0
 MOV #SCENE_BASE,R1
 MOV #HEADER_WORDS,R2
1$: CMP (R0)+,(R1)+
 BNE RT_BADFILE
 SOB R2,1$
 MOV @#177560,RT_TTYCSR
 CLR @#177560
 TST @#177562
 CALL PP_LOAD
 BCS RT_NOPPU
 JMP SPLASH
RT_NOMEM:
 MOV #RT_MEMORY,R4
 BR RT_REPORT
RT_NOFILE:
 MOV #RT_MISSING,R4
 BR RT_REPORT
RT_BADFILE:
 MOV #RT_BADSIZE,R4
 BR RT_REPORT
RT_NOPPU:
 MOV RT_TTYCSR,@#177560
 MOV #RT_PPERR,R4
 BR RT_REPORT
RT_EARLYIO:
 MOV #RT_READERR,R4
 BR RT_REPORT
RT_IOERROR:
 CALL PP_UNLOAD
 MOV RT_TTYCSR,@#177560
 MOV #RT_READERR,R4
 BR RT_REPORT
RT_EXIT:
 CALL PP_UNLOAD
 MOV RT_TTYCSR,@#177560
 CLR R4
RT_REPORT:
 .PURGE #0
 MOV RT_OLDSP,SP
 TST R4
 BEQ 1$
 .PRINT R4
1$: MOV #-1,@#52
 .EXIT
RT_OLDSP: .WORD 0
RT_TTYCSR: .WORD 0
RT_FILE: .RAD50 /DK DARKRMDAT/
RT_AREA: .BLKW 10
RT_MEMORY: .ASCIZ /DARKRM: not enough RT-11 user memory/
RT_MISSING: .ASCIZ /DARKRM: DK:DARKRM.DAT not found/
RT_BADSIZE: .ASCIZ /DARKRM: incompatible DARKRM.DAT/
RT_PPERR: .ASCIZ /DARKRM: cannot allocate PPU memory/
RT_READERR: .ASCIZ /DARKRM: error reading DARKRM.DAT/
 .EVEN

; Input R0 = scene ID. RT-11 file-relative reads support copied/moved files.
DISK_READ:
 ASL R0
 ASL R0
 MOV SCENE_DIR(R0),RT_BLOCK
 MOV SCENE_DIR+2(R0),R1
 SWAB R1
 MOV R1,RT_WORDS
 ; A firmware hard-read error can be transient; retry the same whole record.
 MOV #3,RT_TRIES
1$: .READW #RT_AREA,#0,#SCENE_BASE,RT_WORDS,RT_BLOCK
 BCC 2$
 DEC RT_TRIES
 BNE 1$
 JMP RT_IOERROR
2$:
 RETURN
RT_BLOCK: .WORD 0
RT_WORDS: .WORD 0
RT_TRIES: .WORD 0
