EXPLODE_TIME: .WORD 0
CURRENT_TILE: .WORD 0
HULL: .WORD 0
THRUSTERS: .WORD 0
FLIGHT_HULL: .WORD 0
ALTITUDE: .WORD 0
SHIP_X: .WORD 0
SHIP_Y: .WORD 0
DEBRIS: .BLKW 192.
SPAWN_CLOCK: .WORD 0
SPAWN_LEFT: .WORD 0
SPACE_CLOCK: .WORD 0
DEATHS: .WORD 0
WON: .WORD 0
COOLDOWNS:
STOKE_CD: .WORD 0
GATHER_CD: .WORD 0
TRAPS_CD: .WORD 0
HEAL_CD: .WORD 0
MED_CD: .WORD 0
HYPO_CD: .WORD 0
