; Real-time scheduler: ten game ticks per second, from the PPU's 50 Hz clock.
LOOP: JMP START
START:
 CALL SV_CLEAR
 MOV #STATE_START,R0
 MOV #<STATE_END-STATE_START>/2,R1
1$: CLR (R0)+
 SOB R1,1$
 ; SV_CLEAR synchronizes both planes and the character cache before reset.
 MOV #-1,BUILDER
 MOV #10.,HP
 MOV #10.,MAX_HP
 MOV #10.,MAX_WATER
 MOV #100.,CAPACITY
 MOV #90.,POP_DELAY
 MOV #240.,EVENT_DELAY
 MOV #1,THRUSTERS
 MOV #S_AWAKE,NOTICE
 CALL NOTIFY
 MOV #1,DIRTY
 MOV CLOCK,LAST_CLOCK
 MOV KEY_SERIAL,LAST_KEY
 CALL MAP_INIT
MAIN:
 MOV CLOCK,R0
 SUB LAST_CLOCK,R0
 CMP R0,#5
 BLO 2$
 ADD #5,LAST_CLOCK
 CALL TICK
 BR MAIN
2$: CMP KEY_SERIAL,LAST_KEY
 BEQ 3$
 MOV KEY_SERIAL,LAST_KEY
 MOV KEY_CODE,R0
 MOV #5,REPEAT_CD
 CALL KEY_INPUT
 MOV #1,DIRTY
3$: TST DIRTY
 BEQ 4$
 CLR DIRTY
 CALL DRAW
 CALL TAB_UPDATE
 ; Remove stale bars before disabled glyphs repaint their shared overlay bytes.
 CALL BARS_DRAW
 CALL FLUSH
 CALL TAB_PIXELS
 CALL SV_FRAME
 MOV #1,FOCUS_DIRTY
4$: TST FOCUS_DIRTY
 BEQ MAIN
 CLR FOCUS_DIRTY
 CALL FOCUS_ERASE
 CALL BARS_DRAW
 CALL FOCUS_DRAW
 BR MAIN

TICK:
 ADD #4,FOCUS_PHASE
 BIC #100000,FOCUS_PHASE
 MOV #1,FOCUS_DIRTY
 TST SV_MODE
 BNE 97$
 TST TR_MODE
 BEQ 99$
97$:
 RETURN
99$: CMP TAB,#12.
 BEQ 97$
 CMP TAB,#9.
 BNE 98$
 RETURN
98$: CALL LOG_TICK
 ; Timers run regardless of rendering or active village panel.
 MOV #COOLDOWNS,R4
 MOV #NCOOL,R5
1$: TST (R4)
 BEQ 2$
 DEC (R4)
2$: TST (R4)+
 SOB R5,1$
 INC TENTHS
 CMP TENTHS,#10.
 BLO 4$
 CLR TENTHS
 INC SECONDS
 MOV #1,DIRTY
 CALL VILLAGE_SECOND
4$: TST TR_MODE
 BNE 6$
 CALL REPEAT_KEY
 TST TR_MODE
 BNE 6$
 TST ENEMY_HP
 BEQ 5$
 CALL COMBAT_TICK
5$: TST EXPLODE_TIME
 BEQ 51$
 DEC EXPLODE_TIME
 BNE 51$
 CALL EXPLOSION
51$: CMP TAB,#11.
 BNE 6$
 CALL SPACE_TICK
6$: RETURN

; Changes to resource words saturate at 30000, avoiding signed overflow.
; R0 resource byte offset, R1 signed amount, R2 base (STORES or BAG).
ADD_RESOURCE:
 ADD R0,R2
 TST R1
 BMI 1$
 MOV #30000.,R3
 SUB (R2),R3
 CMP R1,R3
 BLE 2$
 MOV #30000.,(R2)
 RETURN
1$: MOV (R2),R3
 ADD R1,R3
 BPL 2$
 CLR (R2)
 RETURN
2$: ADD R1,(R2)
 RETURN

STATE_START:
FOCUS_PHASE: .WORD 0
FOCUS_DIRTY: .WORD 0
