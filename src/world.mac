; Procedural 61x61 persistent world. Terrain bytes 0..2, landmarks 3..14,
; road 15, village 16, outpost 17. Fog and completed-site arrays are separate.
MAP_INIT:
 MOV #WORLD_MAP,R4
 MOV #3721.,R5
1$: MOV #100.,R1
 CALL RAND_N
 CLR R2
 CMP R0,#15.
 BLO 2$
 INC R2
 CMP R0,#50.
 BLO 2$
 INC R2
2$: MOVB R2,(R4)+
 SOB R5,1$
 MOV #30.,POS_X
 MOV #30.,POS_Y
 MOVB #16.,WORLD_MAP+1860.
 CLR GEN_TYPE
3$: MOV GEN_TYPE,R1
 MUL #10.,R1
 ADD #LANDMARKS,R1
 MOV R1,GEN_REC
 MOV (R1),GEN_LEFT
4$: MOV #61.,R1
 CALL RAND_N
 MOV R0,GEN_X
 MOV #61.,R1
 CALL RAND_N
 MOV R0,GEN_Y
 SUB #30.,R0
 BPL 5$
 NEG R0
5$: MOV GEN_X,R1
 SUB #30.,R1
 BPL 6$
 NEG R1
6$: ADD R1,R0
 MOV GEN_REC,R4
 CMP R0,2(R4)
 BLO 4$
 CMP R0,4(R4)
 BHI 4$
 MOV GEN_Y,R1
 MUL #61.,R1
 ADD GEN_X,R1
 CMPB WORLD_MAP(R1),#3
 BHIS 4$
 MOV GEN_TYPE,R0
 ADD #3,R0
 MOVB R0,WORLD_MAP(R1)
 DEC GEN_LEFT
 BNE 4$
 INC GEN_TYPE
 CMP GEN_TYPE,#NLAND
 BLO 3$
 CALL REVEAL
 RETURN
GEN_REC: .WORD 0
GEN_TYPE: .WORD 0
GEN_LEFT: .WORD 0
GEN_X: .WORD 0
GEN_Y: .WORD 0

MAP_INDEX:
 MOV POS_Y,R1
 MUL #61.,R1
 ADD POS_X,R1
 RETURN
DISTANCE:
 MOV POS_X,R0
 SUB #30.,R0
 BPL 1$
 NEG R0
1$: MOV POS_Y,R1
 SUB #30.,R1
 BPL 2$
 NEG R1
2$: ADD R1,R0
 RETURN
REVEAL:
 MOV #2,REV_RADIUS
 TST PERKS+P_SCOUT
 BEQ 1$
 MOV #4,REV_RADIUS
1$: BR UNCOVER_MAP
UNCOVER_MAP:
 MOV POS_Y,R4
 SUB REV_RADIUS,R4
 MOV POS_Y,REV_END
 ADD REV_RADIUS,REV_END
2$: TST R4
 BMI 6$
 CMP R4,#61.
 BGE 6$
 MOV POS_X,R5
 SUB REV_RADIUS,R5
3$: TST R5
 BMI 5$
 CMP R5,#61.
 BGE 5$
 MOV R4,R0
 SUB POS_Y,R0
 BPL 31$
 NEG R0
31$: MOV R5,R1
 SUB POS_X,R1
 BPL 32$
 NEG R1
32$: ADD R1,R0
 CMP R0,REV_RADIUS
 BGT 5$
 MOV R4,R1
 MUL #61.,R1
 ADD R5,R1
 MOVB #1,MAP_SEEN(R1)
5$: INC R5
 MOV POS_X,R0
 ADD REV_RADIUS,R0
 CMP R5,R0
 BLE 3$
6$: INC R4
 CMP R4,REV_END
 BLE 2$
 RETURN
REV_RADIUS: .WORD 0
REV_END: .WORD 0

CAPACITIES:
 MOV #10.,MAX_HP
 MOV #10.,MAX_WATER
 MOV #100.,CAPACITY
 TST STORES+R_L_ARMOUR
 BEQ 1$
 MOV #15.,MAX_HP
1$: TST STORES+R_I_ARMOUR
 BEQ 2$
 MOV #25.,MAX_HP
2$: TST STORES+R_S_ARMOUR
 BEQ 3$
 MOV #45.,MAX_HP
3$: TST STORES+R_KINETIC_ARMOUR
 BEQ 4$
 MOV #85.,MAX_HP
4$: TST STORES+R_WATERSKIN
 BEQ 5$
 MOV #20.,MAX_WATER
5$: TST STORES+R_CASK
 BEQ 6$
 MOV #30.,MAX_WATER
6$: TST STORES+R_WATER_TANK
 BEQ 7$
 MOV #60.,MAX_WATER
7$: TST STORES+R_FLUID_RECYCLER
 BEQ 8$
 MOV #110.,MAX_WATER
8$: TST STORES+R_RUCKSACK
 BEQ 9$
 MOV #200.,CAPACITY
9$: TST STORES+R_WAGON
 BEQ 10$
 MOV #400.,CAPACITY
10$: TST STORES+R_CONVOY
 BEQ 11$
 MOV #700.,CAPACITY
11$: TST STORES+R_CARGO_DRONE
 BEQ 12$
 MOV #1100.,CAPACITY
12$: RETURN

WEIGH:
 CLR BAG_WEIGHT
 CLR R4
1$: MOV BAG(R4),R1
 MUL WEIGHTS(R4),R1
 ADD R1,BAG_WEIGHT
 ADD #2,R4
 CMP R4,#NRES*2
 BLO 1$
 RETURN
; R0 resource offset. Pack one from home stores or scene loot, R5 source base.
TAKE_ONE:
 MOV R0,TAKE_RES
 MOV R5,TAKE_BASE
 ADD R0,R5
 TST (R5)
 BEQ 9$
 CALL WEIGH
 MOV TAKE_RES,R0
 MOV BAG_WEIGHT,R1
 ADD WEIGHTS(R0),R1
 CMP R1,CAPACITY
 BGT 8$
 INC BAG(R0)
 MOV TAKE_BASE,R5
 ADD R0,R5
 DEC (R5)
 MOV #S_READY,NOTICE
 CALL NOTIFY
 RETURN
8$: MOV #S_FULL,NOTICE
 CALL NOTIFY
9$: RETURN
TAKE_RES: .WORD 0
TAKE_BASE: .WORD 0
DROP_ONE:
 TST BAG(R0)
 BEQ 9$
 DEC BAG(R0)
 TST AWAY
 BNE 9$
 MOV #1,R1
 MOV #STORES,R2
 CALL ADD_RESOURCE
9$: RETURN
EMBARK:
 TST DEATH_CD
 BEQ 1$
 JMP WAIT_MSG
1$: CALL SNAPSHOT_WORLD
 CALL CAPACITIES
 CLR STARVING
 CLR THIRSTY
 MOV MAX_HP,HP
 MOV MAX_WATER,WATER
 MOV #30.,POS_X
 MOV #30.,POS_Y
 MOV #1,AWAY
 MOV #10.,TAB
 CLR MOVES
 CLR LAST_FIGHT
 CLR SELECTED
 MOV #S_COMPASS,NOTICE
 CALL NOTIFY
 RETURN

; R0 direction: 0 up 1 down 2 left 3 right
MOVE:
 CMP R0,#0
 BNE 1$
 TST POS_Y
 BEQ 9$
 DEC POS_Y
 BR 4$
1$: CMP R0,#1
 BNE 2$
 CMP POS_Y,#60.
 BGE 9$
 INC POS_Y
 BR 4$
2$: CMP R0,#2
 BNE 3$
 TST POS_X
 BEQ 9$
 DEC POS_X
 BR 4$
3$: CMP POS_X,#60.
 BGE 9$
 INC POS_X
4$: CALL REVEAL
 INC MOVES
 INC LAST_FIGHT
 CALL MAP_INDEX
 CLR R0
 BISB WORLD_MAP(R1),R0
 MOV R0,CURRENT_TILE
 CMP R0,#16.
 BNE 5$
 JMP GO_HOME
5$: TST WATER
 BEQ 51$
 CLR THIRSTY
 TST PERKS+P_DESERT_RAT
 BEQ 50$
 BIT #1,MOVES
 BNE 52$
50$: DEC WATER
 BR 52$
51$: INC THIRSTY
 CMP THIRSTY,#2
 BLO 511$
 INC DEHYDRATED
 CMP DEHYDRATED,#10.
 BLO 510$
 MOV #1,PERKS+P_DESERT_RAT
510$: JMP DIE_THIRST
511$: MOV #S_DRY,NOTICE
 CALL NOTIFY
52$: BIT #1,MOVES
 BNE 6$
 TST PERKS+P_SLOW_METABOLISM
 BEQ 53$
 BIT #2,MOVES
 BNE 6$
53$: TST BAG+R_CURED_MEAT
 BEQ 54$
 CLR STARVING
 DEC BAG+R_CURED_MEAT
 BEQ 6$
 ADD #8.,HP
 TST PERKS+P_GASTRONOME
 BEQ 531$
 ADD #8.,HP
531$:
 CMP HP,MAX_HP
 BLE 6$
 MOV MAX_HP,HP
 BR 6$
54$: INC STARVING
 CMP STARVING,#2
 BLO 541$
 INC STARVED
 CMP STARVED,#10.
 BLO 540$
 MOV #1,PERKS+P_SLOW_METABOLISM
540$: JMP DIE_HUNGER
541$: MOV #S_HUNGRY,NOTICE
 CALL NOTIFY
6$: TST HP
 BGT 61$
 JMP DIE
61$: CMP CURRENT_TILE,#3
 BLO 7$
 CMP CURRENT_TILE,#15.
 BHIS 9$
 TSTB MAP_DONE(R1)
 BNE 9$
 JMP INSPECT
7$: CMP LAST_FIGHT,#3
 BLO 9$
 MOV #100.,R1
 CALL RAND_N
 MOV #20.,R2
 TST PERKS+P_STEALTHY
 BEQ 71$
 MOV #10.,R2
71$: CMP R0,R2
 BHIS 9$
 CLR LAST_FIGHT
 CALL DISTANCE
 CMP R0,#10.
 BLE 8$
 CMP R0,#20.
 BLE 81$
 MOV #8.,R4
 BR 82$
81$: MOV #4,R4
 BR 82$
8$: CLR R4
82$: MOV CURRENT_TILE,R0
 ; terrain 0 forest, 1 field, 2 barrens -> encounter indices
 TST R4
 BEQ 83$
 CMP R4,#4
 BEQ 84$
 MOV #8.,R0
 CMP CURRENT_TILE,#0
 BEQ 85$
 INC R0
 CMP CURRENT_TILE,#2
 BEQ 85$
 INC R0
 BR 85$
83$: MOV #0,R0
 CMP CURRENT_TILE,#0
 BEQ 85$
 INC R0
 CMP CURRENT_TILE,#2
 BEQ 85$
 INC R0
 BR 85$
84$: MOV #4,R0
 CMP CURRENT_TILE,#2
 BEQ 85$
 INC R0
 CMP CURRENT_TILE,#0
 BEQ 85$
 MOV #7,R0
85$: CMP R0,#2
 BNE 86$
 MOV #2,R1
 CALL RAND_N
 ADD #2,R0
 BR 87$
86$: CMP R0,#4
 BNE 87$
 MOV #2,R1
 CALL RAND_N
 ASL R0
 ADD #4,R0
87$: ASL R0
 MOV ENCOUNTERS(R0),R0
 JMP START_EVENT
9$: RETURN

INSPECT:
 CALL MAP_INDEX
 CLR R0
 BISB WORLD_MAP(R1),R0
 CMP R0,#17.
 BNE 1$
 TSTB MAP_DONE(R1)
 BNE 9$
 MOV #EV_SETPIECES_OUTPOST,R0
 JMP START_EVENT
1$: CMP R0,#3
 BLO 9$
 CMP R0,#15.
 BHIS 9$
 CMP R0,#14.
 BNE 2$
 TST FLAGS+F_EXECUTIONER
 BEQ 2$
 TSTB MAP_DONE(R1)
 BNE 9$
 MOV #EV_EXECUTIONER_EXECUTIONER_ANTECHAMBER,R0
 JMP START_EVENT
2$: TSTB MAP_DONE(R1)
 BNE 9$
 SUB #3,R0
 MOV R0,R1
 MUL #10.,R1
 MOV LANDMARKS+6(R1),R0
 JMP START_EVENT
9$: RETURN

GO_HOME:
 CLR AWAY
 CLR ACTIVE_SCENE
 CLR ENEMY_HP
 CLR EXPLODE_TIME
 CLR POISON
 CLR TAB
 CLR SELECTED
 CLR R4
1$: MOV R4,R0
 MOV BAG(R4),R1
 CLR BAG(R4)
 MOV #STORES,R2
 CALL ADD_RESOURCE
 ADD #2,R4
 CMP R4,#NRES*2
 BLO 1$
 ; Outposts can be used once per expedition.
 MOV #WORLD_MAP,R0
 MOV #MAP_DONE,R1
 MOV #3721.,R2
2$: CMPB (R0)+,#17.
 BNE 3$
 CLRB (R1)
3$: INC R1
 SOB R2,2$
 CALL CAPACITIES
 MOV MAX_HP,HP
 MOV #S_HOME,NOTICE
 CALL NOTIFY
 RETURN
DIE:
 MOV #EV_NATIVE_DEFEAT,R0
 BR DIE_REASON
DIE_HUNGER:
 MOV #EV_NATIVE_HUNGER,R0
 BR DIE_REASON
DIE_THIRST:
 MOV #EV_NATIVE_THIRST,R0
DIE_REASON:
 MOV R0,-(SP)
 CALL RESTORE_WORLD
 INC DEATHS
 MOV #BAG,R0
 MOV #NRES,R1
1$: CLR (R0)+
 SOB R1,1$
 CALL GO_HOME
 MOV #1200.,DEATH_CD
 MOV #S_DEAD,NOTICE
 CALL NOTIFY
 MOV (SP)+,R0
 MOV R0,SCENE_ID
 CALL DISK_READ
 MOV #2,R0
 JMP TR_OPEN

MARK_VISITED:
 CALL MAP_INDEX
 MOVB #1,MAP_DONE(R1)
 RETURN
CLEAR_DUNGEON:
 CALL MAP_INDEX
 MOVB #17.,WORLD_MAP(R1)
 MOVB #1,MAP_DONE(R1)
 MOV MAX_WATER,WATER
 CALL DRAW_ROAD
 RETURN
DRAW_ROAD:
 MOV POS_X,R4
 MOV POS_Y,R5
1$: CMP R4,#30.
 BEQ 3$
 BGT 2$
 INC R4
 BR 21$
2$: DEC R4
21$: CALL ROAD_CELL
 BR 1$
3$: CMP R5,#30.
 BEQ 5$
 BGT 4$
 INC R5
 BR 41$
4$: DEC R5
41$: CALL ROAD_CELL
 BR 3$
5$: RETURN
ROAD_CELL:
 MOV R5,R1
 MUL #61.,R1
 ADD R4,R1
 CMPB WORLD_MAP(R1),#3
 BHIS 1$
 MOVB #15.,WORLD_MAP(R1)
1$: MOVB #1,MAP_SEEN(R1)
 RETURN
; C set when every map cell is already revealed.
MAP_COMPLETE:
 MOV #MAP_SEEN,R0
 MOV #3721.,R1
1$: TSTB (R0)+
 BEQ 2$
 SOB R1,1$
 SEC
 RETURN
2$: CLC
 RETURN
APPLY_MAP:
 CALL MAP_COMPLETE
 BCS 9$
 MOV POS_X,-(SP)
 MOV POS_Y,-(SP)
1$: MOV #61.,R1
 CALL RAND_N
 MOV R0,POS_X
 MOV #61.,R1
 CALL RAND_N
 MOV R0,POS_Y
 CALL MAP_INDEX
 TSTB MAP_SEEN(R1)
 BNE 1$
 MOV #5,REV_RADIUS
 CALL UNCOVER_MAP
 MOV (SP)+,POS_Y
 MOV (SP)+,POS_X
9$: RETURN

SHIP_UPGRADE:
 ; R0 0 hull, 1 engines, 2 liftoff
 CMP R0,#2
 BEQ LIFTOFF
 TST STORES+R_ALIEN_ALLOY
 BNE 1$
 JMP CANT_MSG
1$: DEC STORES+R_ALIEN_ALLOY
 TST R0
 BNE 2$
 INC HULL
 RETURN
2$: INC THRUSTERS
 RETURN
LIFTOFF:
 TST LAUNCH_CD
 BEQ 1$
 JMP WAIT_MSG
1$: TST HULL
 BEQ 9$
 MOV HULL,FLIGHT_HULL
 CLR ALTITUDE
 CLR SPACE_CLOCK
 CLR SPAWN_CLOCK
 MOV #20.,SHIP_X
 MOV #9.,SHIP_Y
 MOV #DEBRIS,R0
 MOV #64.,R1
2$: MOV #-1,(R0)
 ADD #6,R0
 SOB R1,2$
 MOV #11.,TAB
 CLR NOTICE
9$: RETURN
; Sixty seconds, independent of engines. Each asteroid has x/y/speed words.
SPACE_TICK:
 CMP TAB,#11.
 BNE 9$
 MOV #1,DIRTY
 INC SPACE_CLOCK
 CMP SPACE_CLOCK,#10.
 BLO 1$
 CLR SPACE_CLOCK
 INC ALTITUDE
 CMP ALTITUDE,#60.
 BLO 1$
 MOV #1,WON
 JMP END_OPEN
1$: MOV #DEBRIS,R4
 MOV #64.,R5
2$: TST (R4)
 BMI 5$
 MOV 2(R4),R2
 ADD 4(R4),2(R4)
 CMP SHIP_Y,R2
 BLT 4$
 CMP SHIP_Y,2(R4)
 BGT 4$
 MOV (R4),R0
 SUB SHIP_X,R0
 BPL 3$
 NEG R0
3$: CMP R0,#1
 BGT 4$
 MOV #-1,(R4)
 DEC FLIGHT_HULL
 BLE SPACE_CRASH
4$: CMP 2(R4),#19.
 BLO 5$
 MOV #-1,(R4)
5$: ADD #6,R4
 SOB R5,2$
 DEC SPAWN_CLOCK
 BGT 9$
 MOV #100.,R1
 SUB ALTITUDE,R1
 CLR R0
 DIV #10.,R0
 MOV R0,SPAWN_CLOCK
 MOV #1,SPAWN_LEFT
 CMP ALTITUDE,#10.
 BLE 6$
 INC SPAWN_LEFT
 CMP ALTITUDE,#20.
 BLE 6$
 ADD #2,SPAWN_LEFT
 CMP ALTITUDE,#40.
 BLE 6$
 ADD #2,SPAWN_LEFT
6$: MOV #DEBRIS,R4
 MOV #64.,R5
7$: TST (R4)
 BMI 8$
 ADD #6,R4
 SOB R5,7$
 RETURN
8$: MOV #40.,R1
 CALL RAND_N
 MOV R0,(R4)
 CLR 2(R4)
 MOV #3,R1
 CALL RAND_N
 INC R0
 MOV R0,4(R4)
 DEC SPAWN_LEFT
 BGT 6$
9$: RETURN
SPACE_CRASH:
 MOV #7,TAB
 MOV #1200.,LAUNCH_CD
 MOV #S_CRASH,NOTICE
 CALL NOTIFY
 RETURN
; Four-direction text-cell motion; upgrades increase manoeuvrability.
SPACE_MOVE:
 MOV R0,-(SP)
 MOV THRUSTERS,R1
 CLR R0
 DIV #4,R0
 INC R0
 CMP R0,#5
 BLE 1$
 MOV #5,R0
1$: MOV (SP)+,R1
 CMP R1,#116
 BNE 2$
 SUB R0,SHIP_X
 BR 5$
2$: CMP R1,#133
 BNE 3$
 ADD R0,SHIP_X
 BR 5$
3$: CMP R1,#154
 BNE 4$
 SUB R0,SHIP_Y
 BR 5$
4$: CMP R1,#134
 BNE 9$
 ADD R0,SHIP_Y
5$: TST SHIP_X
 BPL 6$
 CLR SHIP_X
6$: CMP SHIP_X,#39.
 BLE 7$
 MOV #39.,SHIP_X
7$: TST SHIP_Y
 BPL 8$
 CLR SHIP_Y
8$: CMP SHIP_Y,#18.
 BLE 9$
 MOV #18.,SHIP_Y
9$: RETURN

; An expedition's world changes commit only on return. Snapshot in the unused
; video-plane space ABOVE the 288-line screen: no disk writes or CPU RAM cost.
SNAPSHOT_WORLD:
 MOV #WORLD_MAP,R0
 MOV #155000,R1
 MOV #5582.,R2
1$: MOV R1,@#176640
 MOV (R0)+,@#176642
 INC R1
 SOB R2,1$
 MOV #FLAGS,R0
 MOV #HOME_FLAGS,R1
 MOV #10.,R2
2$: MOV (R0)+,(R1)+
 SOB R2,2$
 RETURN
RESTORE_WORLD:
 MOV #WORLD_MAP,R0
 MOV #155000,R1
 MOV #5582.,R2
1$: MOV R1,@#176640
 MOV @#176642,(R0)+
 INC R1
 SOB R2,1$
 MOV #FLAGS,R0
 MOV #HOME_FLAGS,R1
 MOV #9.,R2
2$: MOV (R1)+,(R0)+
 SOB R2,2$
 RETURN
